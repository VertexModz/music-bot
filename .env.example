# บน Render ให้ใส่ค่าเหล่านี้ใน Environment Variables (Dashboard > Environment) แทนไฟล์ .env
DISCORD_TOKEN=
CLIENT_ID=
# ใส่ GUILD_ID = คำสั่งขึ้นทันทีในเซิร์ฟเวอร์นั้น / เว้นว่าง = ลงทะเบียนทุกเซิร์ฟเวอร์ (ช้ากว่า)
GUILD_ID=

# ไม่บังคับ: ใช้เมื่อ YouTube บล็อกเซิร์ฟเวอร์ (ดู README)
# วิธีที่ 1: วางไฟล์ cookies.txt ไว้ในโฟลเดอร์โปรเจกต์ (แนะนำ)
# วิธีที่ 2: ใส่ค่า cookie ทั้งชุดตรงนี้
YOUTUBE_COOKIE=
# ไม่บังคับ: proxy เช่น http://user:pass@host:port
YTDLP_PROXY=

# ไม่บังคับ (ขั้นสูง)
# PREFETCH=off      ปิดการโหลดเพลงถัดไปล่วงหน้า (ประหยัด RAM แต่ต่อเพลงช้าลง)
# PORT=3000         พอร์ตของหน้าสถานะ/keep-alive
# YTDLP_PATH=       ระบุตำแหน่ง yt-dlp เอง
# YTDLP_COOKIES=    ระบุตำแหน่งไฟล์ cookies.txt เอง
